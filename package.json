{
  "name": "sc2editor-mcp",
  "version": "1.1.0-alpha.20",
  "private": true,
  "author": {
    "name": "VoVanRusLvSC2",
    "email": "vladimir.lencmanis@gmail.com"
  },
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "MCP bridge for StarCraft II map authoring, native terrain, local CASC resources and lossless lobby/player settings, with existing UI, data, script and scene modules.",
  "scripts": {
    "publication:audit": "node scripts/audit-publication.mjs",
    "publication:prepare": "node scripts/prepare-publication.mjs",
    "project:audit": "node --import tsx scripts/audit-project.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src scripts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "gui": "npm run build && node dist/gui/main.js",
    "gui:dev": "node --import tsx src/gui/main.ts",
    "test": "npm run build && node --test dist/tests/*.test.js tests/terrain-surface/*.test.mjs",
    "ai:discover": "node --import tsx scripts/discover-ai-module.ts",
    "benchmark:ai": "node --import tsx scripts/benchmark-ai-efficiency.ts",
    "ai:schemas": "node --import tsx scripts/generate-ai-schemas.ts",
    "ai:demo": "node --import tsx scripts/demo-ai-migration.ts",
    "browse:schemas": "node --import tsx scripts/generate-browse-placement-schemas.ts",
    "browse:demo": "node --import tsx scripts/demo-browse-placement.ts",
    "schema:audit": "node --import tsx scripts/audit-schema-coverage.ts",
    "schema:audit:data": "node --import tsx scripts/audit-data-coverage.ts",
    "example:button": "node --import tsx scripts/generate-button-demo.ts",
    "schema:evidence": "node --import tsx scripts/generate-schema-evidence.ts",
    "cutscene:discover": "node --import tsx scripts/discover-cutscene-schema.ts",
    "cutscene:discover:editor": "node --import tsx scripts/discover-editor-pe.ts",
    "cutscene:diff-experiment": "node --import tsx scripts/diff-cutscene-experiment.ts",
    "cutscene:matrix": "node --import tsx scripts/cutscene-property-matrix.ts",
    "cutscene:example:editor": "node --import tsx scripts/generate-editor-cutscene-demo.ts",
    "text:discover": "node --import tsx scripts/discover-text-schema.ts",
    "data:discover": "node --import tsx scripts/discover-data-editor.ts",
    "data:discover:corpus": "node --import tsx scripts/discover-data-corpus.ts",
    "data:xsd:index": "node --import tsx scripts/index-data-xsd.ts",
    "data:example": "node --import tsx scripts/generate-data-recipes-demo.ts",
    "cutscene:corpus:verify": "node --import tsx scripts/verify-cutscene-corpus.ts",
    "corpus:verify": "node --import tsx scripts/verify-corpus.ts",
    "runtime:corpus": "node --import tsx scripts/runtime-corpus.ts",
    "archive": "node --import tsx scripts/archive-workspace.ts",
    "archive:build": "node scripts/build-native-archive.mjs",
    "archive:verify": "node --import tsx scripts/verify-native-archives.ts",
    "map:schemas": "node --import tsx scripts/generate-map-schemas.ts",
    "gui:archive": "node --import tsx scripts/gui-archive.ts",
    "benchmark:codex": "node --import tsx scripts/benchmark-codex-efficiency.ts",
    "benchmark:cutscene": "node --import tsx scripts/benchmark-cutscene-efficiency.ts",
    "benchmark:text": "node --import tsx scripts/benchmark-text-efficiency.ts",
    "benchmark:data": "node --import tsx scripts/benchmark-data-efficiency.ts",
    "windows:portable": "npm run build:release && node scripts/build-windows-portable.mjs",
    "terrain:schemas": "node --import tsx scripts/generate-terrain-schemas.ts",
    "terrain:demo": "node --import tsx scripts/demo-terrain.ts",
    "terrain:discover": "node --import tsx scripts/discover-terrain-editor.ts",
    "benchmark:terrain": "node --import tsx scripts/benchmark-terrain-doodads.ts",
    "build:release": "tsc -p tsconfig.release.json",
    "build:incremental": "tsc -p tsconfig.dev.json",
    "script:api": "node --import tsx scripts/generate-galaxy-api.ts",
    "map:discover:executables": "node --import tsx scripts/analyze-map-executables.ts",
    "terrain:catalog:scan": "node scripts/scan-terrain-catalogs.mjs",
    "casc:build": "node scripts/build-native-casc.mjs",
    "casc:schemas": "node --import tsx scripts/generate-casc-schemas.ts",
    "settings:schemas": "node --import tsx scripts/generate-settings-schemas.ts",
    "document:schemas": "node --import tsx scripts/generate-document-schemas.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@xmldom/xmldom": "0.9.12",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20"
  }
}
