  "tools": {
    "ai.context": {
      "description": "One-call selective context for native CustomAI definitions, waves, composition, timing, references, Trigger bindings, dependencies, diagnostics and operation registry.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "definitions": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "waves": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "units": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includeNative": {
            "default": false,
            "type": "boolean"
          },
          "includeTriggers": {
            "default": true,
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "includeNative",
          "includeTriggers",
          "limit"
        ],
        "additionalProperties": false
      }
    },
    "ai.query": {
      "description": "Batch-search CustomAI definitions/waves, timing, unit composition, dependency references, Trigger bindings or invalid references.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "definitions",
              "waves",
              "references",
              "triggerBindings",
              "invalid"
            ]
          },
          "text": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "minTime": {
            "type": "number",
            "minimum": 0
          },
          "maxTime": {
            "type": "number",
            "minimum": 0
          },
          "limit": {
            "default": 100,
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        },
        "required": [
          "limit"
        ],
        "additionalProperties": false
      }
    },
